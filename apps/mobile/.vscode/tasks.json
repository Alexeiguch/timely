{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Mobile: Start Metro",
      "type": "shell",
      "command": "node",
      "args": [
        "--dns-result-order=ipv4first",
        "node_modules/expo/bin/cli",
        "start",
        "--dev-client",
        "--clear",
        "--localhost",
        "--port",
        "8081"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "EXPO_PUBLIC_API_URL": "http://localhost:3001",
          "APP_VARIANT": "development",
          "REACT_NATIVE_PACKAGER_HOSTNAME": "127.0.0.1"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "expo",
        "pattern": {
          "regexp": "^(?!)()()()$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Starting project.*",
          "endsPattern": ".*(Metro waiting on|Waiting on http|Metro:).*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Mobile: Repair Expo Tools 1.6.3 debugger",
      "type": "shell",
      "command": "node",
      "args": [
        "../../scripts/patch-expo-vscode-debugger.mjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Mobile: Build iOS development app",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "exec",
        "expo",
        "run:ios",
        "--no-bundler"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "EXPO_PUBLIC_API_URL": "http://localhost:3001",
          "APP_VARIANT": "development"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}

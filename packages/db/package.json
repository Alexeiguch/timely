{
  "name": "@timely/db",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./planner": "./src/planner.ts",
    "./account": "./src/account.ts",
    "./history": "./src/history.ts",
    "./notifications": "./src/notifications.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "postgres": "3.4.9",
    "@timely/contracts": "workspace:*",
    "@timely/domain": "workspace:*",
    "@timely/sync": "workspace:*"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11"
  }
}

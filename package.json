{
  "name": "timely",
  "private": true,
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --filter @timely/web dev",
    "dev:mobile": "pnpm --filter @timely/mobile start",
    "build": "pnpm --filter @timely/web build",
    "typecheck": "turbo typecheck",
    "test": "vitest run",
    "lint": "node scripts/check-boundaries.mjs",
    "db:generate": "pnpm --filter @timely/db generate",
    "db:migrate": "pnpm --filter @timely/db migrate",
    "test:e2e": "playwright test",
    "test:auth": "node scripts/auth-smoke.mjs",
    "doctor:mobile": "pnpm --filter @timely/mobile run doctor",
    "fix:expo-vscode-debugger": "node scripts/patch-expo-vscode-debugger.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "auth": "1.7.6",
    "tsx": "4.21.0",
    "turbo": "2.11.5",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@neon/config": "1.8.3",
    "@neon/env": "1.4.8"
  },
  "type": "module",
  "pnpm": {
    "patchedDependencies": {
      "@react-native/dev-middleware@0.86.3": "patches/@react-native__dev-middleware@0.86.3.patch",
      "expo-modules-core@57.0.20": "patches/expo-modules-core@57.0.20.patch",
      "expo-modules-jsi@57.1.1": "patches/expo-modules-jsi@57.1.1.patch"
    },
    "overrides": {
      "@better-auth/utils": "0.4.2",
      "expo": "57.0.26",
      "@expo/metro-runtime": "57.0.16",
      "@expo/dom-webview": "57.0.1",
      "@expo/log-box": "57.0.4",
      "react-native-worklets": "0.10.1",
      "react-native-reanimated": "4.5.1",
      "@react-native/metro-config": "0.86.3"
    }
  }
}
